.venv/
__pycache__/
*.pyc
.pytest_cache/
data/raw/*
!data/raw/.gitkeep
results/*
!results/.gitkeep
# Bulk result tables stay out -- they are regenerable and large. These are not:
# the selected configuration that committed code reads by path, the meta files
# that record each run's exact protocol, and the small cohort-quality table the
# README cites. Keeping them tracked is what makes a reported number auditable
# without rerunning three hours of compute.
!results/*_meta.json
!results/*_chosen.json
!results/*_chosen_steprule.json
!results/db3_signal_quality.csv
*.pt
.DS_Store
results/selfcheck_*
results/pilot_*
